{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.beaconmind.invalid/bm.providers-1.schema.json",
  "$comment": "AI-assisted: Grok 4.7 via Cursor, 2026-10-06: wrote this schema from plan/README.md C11.",
  "title": "bm.providers/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "models"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema": {
      "const": "bm.providers/1"
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "api_key_env",
          "price_usd_per_mtok",
          "price_checked",
          "options"
        ],
        "properties": {
          "provider": {
            "enum": [
              "vllm",
              "openai_responses",
              "anthropic_messages"
            ]
          },
          "model": {
            "type": "string"
          },
          "api_key_env": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_usd_per_mtok": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "cached_input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number"
              },
              "cached_input": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "output": {
                "type": "number"
              }
            }
          },
          "price_checked": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            ]
          },
          "options": {
            "type": "object"
          },
          "base_url": {
            "type": "string"
          },
          "thinking": {
            "type": "boolean"
          },
          "sampling": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "temperature": {
                "type": "number"
              },
              "top_p": {
                "type": "number"
              },
              "top_k": {
                "type": "number"
              },
              "presence_penalty": {
                "type": "number"
              }
            }
          },
          "max_turns_per_step": {
            "type": "integer",
            "minimum": 1
          },
          "request_timeout_s": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
