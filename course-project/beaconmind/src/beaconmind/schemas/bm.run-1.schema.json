{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.beaconmind.invalid/bm.run-1.schema.json",
  "$comment": "AI-assisted: Grok 4.7 via Cursor, 2026-10-06: wrote this schema from plan/README.md C9.2.",
  "title": "bm.run/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "arm",
    "model_key",
    "provider",
    "prompt_sha12",
    "tool_schema_sha12",
    "dv_sha12",
    "harness_hashes",
    "seeds",
    "K",
    "budget_usd",
    "start_time",
    "end_time",
    "host"
  ],
  "properties": {
    "schema": {
      "const": "bm.run/1"
    },
    "arm": {
      "enum": [
        "L2",
        "B0",
        "B1",
        "B2",
        "L1",
        "L3",
        "N",
        "V"
      ]
    },
    "model_key": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "api_key_env",
        "price_usd_per_mtok",
        "price_checked",
        "options"
      ],
      "properties": {
        "provider": {
          "enum": [
            "vllm",
            "openai_responses",
            "anthropic_messages"
          ]
        },
        "model": {
          "type": "string"
        },
        "api_key_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_usd_per_mtok": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "cached_input",
            "output"
          ],
          "properties": {
            "input": {
              "type": "number"
            },
            "cached_input": {
              "type": [
                "number",
                "null"
              ]
            },
            "output": {
              "type": "number"
            }
          }
        },
        "price_checked": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ]
        },
        "options": {
          "type": "object"
        },
        "base_url": {
          "type": "string"
        },
        "thinking": {
          "type": "boolean"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "number"
            },
            "top_p": {
              "type": "number"
            },
            "top_k": {
              "type": "number"
            },
            "presence_penalty": {
              "type": "number"
            }
          }
        },
        "max_turns_per_step": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "prompt_sha12": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "tool_schema_sha12": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "dv_sha12": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "harness_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "K": {
      "type": "integer",
      "minimum": 1
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "host": {
      "type": "string"
    }
  }
}
