{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.beaconmind.invalid/bm.world-1.schema.json",
  "$comment": "AI-assisted: Grok 4.7 via Cursor, 2026-10-06: wrote this schema from plan/README.md C7.",
  "title": "bm.world/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "world_id",
    "source",
    "seed",
    "generator",
    "condition",
    "arena",
    "tags",
    "duplicates",
    "roof_tags",
    "start_pose",
    "measured"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema": {
      "const": "bm.world/1"
    },
    "world_id": {
      "type": "string"
    },
    "source": {
      "enum": [
        "sim",
        "real"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "condition": {
      "enum": [
        "unique",
        "duplicated",
        "hidden"
      ]
    },
    "arena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "size_m",
        "wall_height_m",
        "origin"
      ],
      "properties": {
        "shape": {
          "type": "string"
        },
        "size_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "wall_height_m": {
          "type": "number"
        },
        "origin": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uid",
          "id",
          "family",
          "black_size_m",
          "border_size_m",
          "wall",
          "x_m",
          "y_m",
          "z_m",
          "normal_deg"
        ],
        "properties": {
          "uid": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 29
          },
          "family": {
            "const": "tag36h11"
          },
          "black_size_m": {
            "type": "number"
          },
          "border_size_m": {
            "type": "number"
          },
          "wall": {
            "type": "string"
          },
          "x_m": {
            "type": "number"
          },
          "y_m": {
            "type": "number"
          },
          "z_m": {
            "type": "number"
          },
          "normal_deg": {
            "type": "number"
          }
        }
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "roof_tags": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 100,
        "maximum": 109
      }
    },
    "start_pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_m",
        "y_m",
        "theta_deg"
      ],
      "properties": {
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "theta_deg": {
          "type": "number"
        }
      }
    },
    "measured": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    }
  }
}
