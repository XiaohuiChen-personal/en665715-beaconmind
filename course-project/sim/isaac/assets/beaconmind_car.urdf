      <geometry>
        <box size="0.038 0.02 0.0135"/>
      </geometry>
    </collision>
    <visual name="camera_stand_visual">
      <origin rpy="0 0 0" xyz="0.11 0.0 0.047"/>
      <geometry>
        <box size="0.008 0.008 0.039"/>
      </geometry>
      <material name="stand_grey">
        <color rgba="0.62 0.62 0.62 1"/>
      </material>
    </visual>
    <collision name="camera_stand_collision">
      <origin rpy="0 0 0" xyz="0.11 0.0 0.047"/>
      <geometry>
        <box size="0.008 0.008 0.039"/>
      </geometry>
    </collision>
    <!-- Inertia: box approximation. The chassis is treated as ONE uniform solid box of chassis_mass,
         207 x 100 x 36 mm (plate length x strip width x main-body height, motor bottoms to battery top),
         centred on the chassis centre of mass and aligned with base_link. Not measured; good enough for
         a slow indoor car (no pendulum / bifilar measurement was made). -->
    <inertial>
      <origin rpy="0 0 0" xyz="0.035973871 -0.00023753 0.0145"/>
      <mass value="0.421"/>
      <inertia ixx="0.0003963013333333334" ixy="0" ixz="0" iyy="0.0015484632740333333" iyz="0" izz="0.0018538286073666666"/>
    </inertial>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="left_wheel_link">
    <!-- What you see: the real tyre, a cylinder 67 mm across and 27 mm wide. -->
    <visual name="left_tyre_visual">
      <geometry>
        <cylinder length="0.027" radius="0.0335"/>
      </geometry>
      <material name="tyre_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <!-- What touches the floor: a SPHERE of the wheel radius. Reason given in the instructor's Module 6 guide
           (section 5.1): a sphere meets the ground at one point in the middle of the tyre, like a real tyre, while a
           cylinder meets it at its edges, which in the instructor's testing made the simulated robot turn about 20 %
           more than its wheel odometry computed. Side effect: the sphere bulges 20 mm past the tyre's outer face
           (|y| up to 100 mm) and into the body; self-collision is off by default in Gazebo and in the Isaac
           importer, so the inner overlap is harmless.
           Left UNNAMED on purpose: sdformat's URDF converter (checked with gz sdf 14.9 on 2026-10-10) drops the
           <gazebo reference> friction (mu1/mu2) of a link whose <collision> has a name attribute. -->
    <collision>
      <geometry>
        <sphere radius="0.0335"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="1.0239375e-05" ixy="0" ixz="0" iyy="1.0239375e-05" iyz="0" izz="1.683375e-05"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0.06675 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_wheel_link">
    <!-- What you see: the real tyre, a cylinder 67 mm across and 27 mm wide. -->
    <visual name="right_tyre_visual">
      <geometry>
        <cylinder length="0.027" radius="0.0335"/>
      </geometry>
      <material name="tyre_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <!-- What touches the floor: a SPHERE of the wheel radius. Reason given in the instructor's Module 6 guide
           (section 5.1): a sphere meets the ground at one point in the middle of the tyre, like a real tyre, while a
           cylinder meets it at its edges, which in the instructor's testing made the simulated robot turn about 20 %
           more than its wheel odometry computed. Side effect: the sphere bulges 20 mm past the tyre's outer face
           (|y| up to 100 mm) and into the body; self-collision is off by default in Gazebo and in the Isaac
           importer, so the inner overlap is harmless.
           Left UNNAMED on purpose: sdformat's URDF converter (checked with gz sdf 14.9 on 2026-10-10) drops the
           <gazebo reference> friction (mu1/mu2) of a link whose <collision> has a name attribute. -->
    <collision>
      <geometry>
        <sphere radius="0.0335"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="1.0239375e-05" ixy="0" ixz="0" iyy="1.0239375e-05" iyz="0" izz="1.683375e-05"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 -0.06675 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- ================= Caster ================= -->
  <!-- The swivel caster's white wheel, modelled as a sphere of radius caster_radius centred caster_radius above the
       floor at the TRAILING contact point (caster_x = 100 mm measured), so it touches the floor exactly:
       sphere bottom = caster_z - caster_radius = -wheel_radius. -->
  <link name="caster_link">
    <visual name="caster_wheel_visual">
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
      <material name="caster_white">
        <color rgba="0.95 0.95 0.95 1"/>
      </material>
    </visual>
    <!-- Visual only (no collision, no mass): a block standing for the metal fork and top plate, from the wheel centre
         up to the plate underside and forward to just past the swivel axis (caster_swivel_x = 120 mm, measured C3).
         Its 22 mm width and the 2 mm / 8 mm margins are an ESTIMATE from IMG_7436. -->
    <visual name="caster_fork_visual">
      <origin rpy="0 0 0" xyz="0.013 0 0.016"/>
      <geometry>
        <box size="0.03 0.022 0.032"/>
      </geometry>
      <material name="caster_metal">
        <color rgba="0.70 0.70 0.72 1"/>
      </material>
    </visual>
    <!-- Unnamed on purpose, like the tyres: a named collision loses the lab's mu = 0 caster friction in Gazebo.
         Isaac Sim (M2.T16): URDF carries no friction, and this file has no simulator blocks. The real caster SWIVELS,
         but here it is a fixed sphere, so it must slide freely: M2.T16 must bind a physics material with static and
         dynamic friction 0.0 to THIS collider (the plan's "caster 0.0"), and friction 1.0 to the two wheel colliders.
         With any non-zero friction the fixed sphere would drag sideways in turns, which a real swivel caster does not. -->
    <collision>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="6.25e-07" ixy="0" ixz="0" iyy="6.25e-07" iyz="0" izz="6.25e-07"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin rpy="0 0 0" xyz="0.1 0.0 -0.021"/>
  </joint>
  <!-- ================= Camera ================= -->
  <!-- camera_link = the lens (optical centre), x forward, z up. camera_roll/pitch/yaw are 0: ASSUMED, not measured;
       the M1.T7 calibration (camera.json extrinsics) will set them. -->
  <link name="camera_link">
    <!-- The camera module, just behind the lens (visual only, size ESTIMATE). -->
    <visual name="camera_module_visual">
      <origin rpy="0 0 0" xyz="-0.003 0 0"/>
      <geometry>
        <box size="0.006 0.0085 0.0085"/>
      </geometry>
      <material name="camera_dark">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1.2041666666666667e-07" ixy="0" ixz="0" iyy="9.020833333333334e-08" iyz="0" izz="9.020833333333334e-08"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.12 0.0 0.0415"/>
  </joint>
  <!-- REP 103 optical frame: z forward (along the lens axis), x right, y down. Images are stamped with this frame. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ================= IMU ================= -->
  <!-- imu_link = the BNO055 board centre at its top surface. rpy 0: ASSUMED (board flat and square to the car).
       The board's box is drawn in chassis_link (imu_board); this link carries only the frame and the stand-in mass. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1.7708333333333334e-07" ixy="0" ixz="0" iyy="3.1416666666666664e-07" iyz="0" izz="4.704166666666667e-07"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.061 0.02 0.0265"/>
  </joint>
</robot>
