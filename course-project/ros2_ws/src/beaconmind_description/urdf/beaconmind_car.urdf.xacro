<?xml version="1.0"?>
<!--
  AI-assisted: Claude Opus 5.5 (xhigh effort) via Claude Code, 2026-10-10: wrote the URDF/xacro, launch file and tests.
  AI-assisted: Claude Opus 5.5 via Claude Code, 2026-10-16: drew the plate's rounded front (front_slices, from the
  classmate's plate CAD in the private course repo (plate CAD is not published here)) and updated the plate comments for the CAD outline.

  beaconmind_car.urdf.xacro: the ONE robot description of Xiaohui Chen's two-wheel car, shared by
    (a) the Module 6 Gazebo Fortress lab (assignments/assignment6, wrapped with the instructor's <gazebo> blocks), and
    (b) the BeaconMind course project (robot_state_publisher TF tree, C12; Isaac Sim twin, M2.T4 / M2.T16).

  Frames (README C1): base_link = midpoint between the drive-wheel centres AT AXLE HEIGHT (z = 0 at the axle);
  +x toward the camera lens / caster end (the front); +y = robot left; +z up. Floor is at z = -wheel_radius.
  Every number comes from two files in this folder: car_props.xacro, GENERATED by beaconmind_description/gen_props.py
  from configs/car.json (M1.T9; never edit it by hand), and car_geometry_extras.xacro, hand-written, for the geometry
  car.json does not carry (plate outline, part boxes, part masses). Both label each value measured / derived /
  ESTIMATE / ASSUMED / stand-in. The camera pose stays provisional until configs/camera.json (M1.T7) exists.

  Links (exactly): base_link, chassis_link, left_wheel_link, right_wheel_link, caster_link, camera_link,
  camera_optical_frame, imu_link.
  This file has NO <gazebo>, <sensor>, ray or lidar elements (D1a: no range sensor). Simulator-specific
  blocks belong in a wrapper (for the lab: assignments/assignment6/lab-step10/gazebo_car.urdf.xacro).
-->
<robot name="beaconmind_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Relative to THIS file's folder, so they resolve wherever this file is included from
       (the package share, the source tree, or the lab container's /description mount).
       car_props.xacro: generated from car.json. car_geometry_extras.xacro: hand-written; defines no property of
       car_props.xacro (test_props_files_do_not_overlap), so neither file can silently override the other. -->
  <xacro:include filename="car_props.xacro"/>
  <xacro:include filename="car_geometry_extras.xacro"/>

  <!-- ================= Guards: stop xacro with an error instead of building a wrong model ================= -->
  <xacro:if value="${caster_radius &lt;= 0}">
    ${xacro.fatal('caster_radius must be > 0 (the caster sphere must touch the floor), got %s' % caster_radius)}
  </xacro:if>
  <xacro:if value="${motor_y_outer &gt;= track_inner / 2}">
    ${xacro.fatal('motor boxes (|y| up to %s) would overlap the tyres (inner face at |y| = %s)' % (motor_y_outer, track_inner / 2))}
  </xacro:if>
  <xacro:if value="${battery_x_min &lt; breadboard_x_max}">
    ${xacro.fatal('battery holder (x from %s) would overlap the breadboard (x to %s)' % (battery_x_min, breadboard_x_max))}
  </xacro:if>
  <xacro:if value="${axle_to_front &lt;= esp32_x_min}">
    ${xacro.fatal('ESP32-CAM stack would have no length: front %s is not ahead of rear %s' % (axle_to_front, esp32_x_min))}
  </xacro:if>
  <xacro:if value="${wing_slices != 4}">
    ${xacro.fatal('wing_slices is %s, but chassis_link instantiates exactly 4 plate_wing_slice calls' % wing_slices)}
  </xacro:if>
  <xacro:if value="${front_slices != 3}">
    ${xacro.fatal('front_slices is %s, but chassis_link instantiates exactly 3 plate_front_slice calls' % front_slices)}
  </xacro:if>
  <!-- The rounded front needs 0 < corner radius < strip half-width < arc radius (else the fillet cannot touch both). -->
  <xacro:if value="${not (0 &lt; plate_front_corner_radius &lt; plate_strip_width / 2 &lt; plate_front_arc_radius)}">
    ${xacro.fatal('plate front radii impossible: corner %s, half-width %s, arc %s' % (plate_front_corner_radius, plate_strip_width / 2, plate_front_arc_radius))}
  </xacro:if>
  <!-- chassis_height (car.json chassis_height_m) is B10_battery_holder_top_h - B9_lowest_body_h; the extras file holds
       both readings, so a re-measure that updates only one of the two files stops here. -->
  <xacro:if value="${math.fabs(chassis_height - (battery_top_h - lowest_body_h)) &gt; 1e-9}">
    ${xacro.fatal('chassis_height %s (car.json) is not battery_top_h - lowest_body_h = %s (car_geometry_extras.xacro)' % (chassis_height, battery_top_h - lowest_body_h))}
  </xacro:if>

  <!-- ================= Derived model quantities ================= -->
  <xacro:property name="plate_top_h" value="${round(plate_underside_h + plate_thickness, 6)}"/>
  <!-- The rear wing is plate_rear_x to wing_front_x; the 100 mm strip runs from wing_front_x to plate_front_x. -->
  <!-- Slice boundaries sit on a 2 um grid (snap2um): body_box rounds a box's centre and size to 1 um separately, so a
       boundary between two boxes is exact only when both neighbours' centres and half-sizes are whole micrometres,
       i.e. when the boundaries are multiples of 2 um. The CAD wing depth makes 8.5875 mm slices, which without the grid
       left slices 3 and 4 overlapping by 1 um (test_chassis_boxes_do_not_overlap). Snapping moves a boundary by at
       most 1 um. -->
  <xacro:property name="snap2um" value="${lambda v: round(round(v / 2e-6) * 2e-6, 6)}"/>
  <xacro:property name="wing_front_x" value="${snap2um(plate_rear_x + wing_depth)}"/>
  <xacro:property name="wing_slice" value="${wing_depth / wing_slices}"/>
  <!-- The rounded front (car_model.rounded_front in beaconmind, same formulas): the front arc's centre is at
       x = plate_front_x - R; each corner fillet's centre is (xf, w - r) with
       xf = front_arc_cx + sqrt((R - r)^2 - (w - r)^2), where w = plate_strip_width / 2. The full-width strip ends at
       x = xf (where the straight side meets the fillet); the fillet meets the arc at x = front_tangent_x. With the CAD
       values: front_arc_cx = -4.65 mm, xf = 115.35 mm, front_tangent_x = 122.90 mm. -->
  <xacro:property name="front_arc_cx" value="${plate_front_x - plate_front_arc_radius}"/>
  <xacro:property name="front_fillet_cy" value="${plate_strip_width / 2 - plate_front_corner_radius}"/>
  <xacro:property name="front_fillet_cx"
                  value="${front_arc_cx + math.sqrt((plate_front_arc_radius - plate_front_corner_radius) ** 2 - front_fillet_cy ** 2)}"/>
  <xacro:property name="front_tangent_x"
                  value="${front_arc_cx + plate_front_arc_radius / (plate_front_arc_radius - plate_front_corner_radius) * (front_fillet_cx - front_arc_cx)}"/>
  <xacro:property name="front_round_x" value="${snap2um(front_fillet_cx)}"/>
  <xacro:property name="front_slice" value="${(plate_front_x - front_round_x) / front_slices}"/>
  <!-- Chassis mass = measured total minus the stand-in part masses: 0.506 - 2 x 0.030 - 0.010 - 0.010 - 0.005 = 0.421 kg -->
  <xacro:property name="chassis_mass" value="${round(mass - 2 * wheel_mass - caster_mass - camera_mass - imu_mass, 9)}"/>
  <!-- Chassis centre of mass, chosen so that the WHOLE car's centre of mass is at x = com_x (lever-rule value,
       car_geometry_extras.xacro) and y = 0 (ASSUMED symmetric: no sideways weighing was made). The wheels sit at x = y = 0
       and add nothing.
       chassis_com_x = (mass*com_x - caster_mass*caster_x - camera_mass*camera_x - imu_mass*imu_x) / chassis_mass
       chassis_com_y = -(caster_mass*caster_y + camera_mass*camera_y + imu_mass*imu_y) / chassis_mass
       (with imu_y = +0.020 this is about -0.24 mm, which cancels the IMU's stand-in 5 g on the left).
       9 decimals so that the whole-car COM matches the lever rule within 1e-6 m. -->
  <xacro:property name="chassis_com_x"
                  value="${round((mass * com_x - caster_mass * caster_x - camera_mass * camera_x - imu_mass * imu_x) / chassis_mass, 9)}"/>
  <xacro:property name="chassis_com_y"
                  value="${round(-(caster_mass * caster_y + camera_mass * camera_y + imu_mass * imu_y) / chassis_mass, 9)}"/>

  <!-- ================= Materials (colours of the real parts) ================= -->
  <!-- Colours are written inline in every <visual>: Gazebo Fortress's URDF-to-SDF step (sdformat 12) resolves a by-name
       <material> only for the FIRST <visual> of each link, so the link's other visuals turned black (diffuse 0 0 0 1). -->
  <xacro:property name="part_colours" value="${dict(
      plate_clear_grey='0.80 0.83 0.86 1',
      breadboard_white='0.95 0.95 0.93 1',
      battery_black='0.08 0.08 0.08 1',
      motor_light_blue='0.45 0.72 0.92 1',
      esp32_black='0.04 0.04 0.04 1',
      stand_grey='0.62 0.62 0.62 1',
      imu_purple='0.45 0.15 0.60 1',
      tyre_black='0.05 0.05 0.05 1',
      caster_white='0.95 0.95 0.95 1',
      caster_metal='0.70 0.70 0.72 1',
      camera_dark='0.15 0.15 0.15 1')}"/>
  <!-- The <material> of one <visual>: the colour's name plus its rgba from part_colours (the only place it is defined). -->
  <xacro:macro name="part_material" params="name">
    <xacro:if value="${name not in part_colours}">
      ${xacro.fatal('colour %s is not in part_colours' % name)}
    </xacro:if>
    <material name="${name}"><color rgba="${part_colours[name]}"/></material>
  </xacro:macro>

  <!-- ================= Inertia helpers (standard solid-body formulas) ================= -->
  <!-- Solid box of mass m and edge lengths sx, sy, sz, about its centre, axes along its edges. -->
  <xacro:macro name="solid_box_inertia" params="m sx sy sz">
    <inertia ixx="${m * (sy * sy + sz * sz) / 12}" ixy="0" ixz="0"
             iyy="${m * (sx * sx + sz * sz) / 12}" iyz="0"
             izz="${m * (sx * sx + sy * sy) / 12}"/>
  </xacro:macro>
  <!-- Solid cylinder of mass m, radius r, length h, about its centre; its axis is the local z. -->
  <xacro:macro name="solid_cylinder_inertia" params="m r h">
    <inertia ixx="${m * (3 * r * r + h * h) / 12}" ixy="0" ixz="0"
             iyy="${m * (3 * r * r + h * h) / 12}" iyz="0"
             izz="${m * r * r / 2}"/>
  </xacro:macro>
  <!-- Solid sphere of mass m and radius r, about its centre. -->
  <xacro:macro name="solid_sphere_inertia" params="m r">
    <inertia ixx="${2 * m * r * r / 5}" ixy="0" ixz="0"
             iyy="${2 * m * r * r / 5}" iyz="0"
             izz="${2 * m * r * r / 5}"/>
  </xacro:macro>

  <!-- One named box of the chassis: a <visual> and a <collision> with the same geometry.
       x and y are base_link coordinates; h_min / h_max are heights above the FLOOR (converted to model z here).
       Named collisions are fine here because nothing sets Gazebo friction on chassis_link; if a
       <gazebo reference="chassis_link"> surface block is ever added, drop the collision names (see the tyres). -->
  <xacro:macro name="body_box" params="name x_min x_max y_min y_max h_min h_max material">
    <visual name="${name}_visual">
      <origin xyz="${round((x_min + x_max) / 2, 6)} ${round((y_min + y_max) / 2, 6)} ${round((h_min + h_max) / 2 - wheel_radius, 6)}" rpy="0 0 0"/>
      <geometry><box size="${round(x_max - x_min, 6)} ${round(y_max - y_min, 6)} ${round(h_max - h_min, 6)}"/></geometry>
      <xacro:part_material name="${material}"/>
    </visual>
    <collision name="${name}_collision">
      <origin xyz="${round((x_min + x_max) / 2, 6)} ${round((y_min + y_max) / 2, 6)} ${round((h_min + h_max) / 2 - wheel_radius, 6)}" rpy="0 0 0"/>
      <geometry><box size="${round(x_max - x_min, 6)} ${round(y_max - y_min, 6)} ${round(h_max - h_min, 6)}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- One slice i (1 = rearmost) of the rear wing. The wing's rear edge is a half-ellipse centred at (wing_front_x, 0)
       with semi-axes wing_depth along x and body_width / 2 along y. A slice is wing_depth / wing_slices deep; its width
       is the ellipse's width at the slice's mid-depth d = (i - 1/2) * wing_slice in from the rear edge:
           width = body_width * sqrt(1 - ((wing_depth - d) / wing_depth)^2)
       (34.35 x 73.96 mm, 4 slices: d = 4.29, 12.88, 21.47, 30.06 mm -> 71.6, 115.5, 137.1, 146.8 mm). -->
  <xacro:macro name="plate_wing_slice" params="i">
    <xacro:property name="slice_mid_depth" value="${(i - 0.5) * wing_slice}"/>
    <xacro:property name="slice_width"
                    value="${round(body_width * math.sqrt(1 - ((wing_depth - slice_mid_depth) / wing_depth) ** 2), 6)}"/>
    <xacro:body_box name="plate_wing_${i}" x_min="${snap2um(plate_rear_x + (i - 1) * wing_slice)}"
                    x_max="${snap2um(plate_rear_x + i * wing_slice)}"
                    y_min="${-slice_width / 2}" y_max="${slice_width / 2}"
                    h_min="${plate_underside_h}" h_max="${plate_top_h}" material="plate_clear_grey"/>
  </xacro:macro>

  <!-- One slice i (1 = rearmost) of the rounded front, from front_round_x to the apex plate_front_x. A slice is
       front_slice deep; its width is twice the outline's half-width at the slice's middle x_m: on the corner fillet
       (x_m <= front_tangent_x) w - r + sqrt(r^2 - (x_m - xf)^2), on the front arc sqrt(R^2 - (x_m - front_arc_cx)^2)
       (CAD values, 3 slices of 5.05 mm: 99.2, 89.2, 52.0 mm). -->
  <xacro:macro name="plate_front_slice" params="i">
    <xacro:property name="slice_mid_x" value="${front_round_x + (i - 0.5) * front_slice}"/>
    <xacro:property name="slice_width"
                    value="${round(2 * ((front_fillet_cy + math.sqrt(plate_front_corner_radius ** 2 - (slice_mid_x - front_fillet_cx) ** 2)) if slice_mid_x &lt;= front_tangent_x else math.sqrt(plate_front_arc_radius ** 2 - (slice_mid_x - front_arc_cx) ** 2)), 6)}"/>
    <xacro:body_box name="plate_front_${i}" x_min="${snap2um(front_round_x + (i - 1) * front_slice)}"
                    x_max="${snap2um(front_round_x + i * front_slice)}"
                    y_min="${-slice_width / 2}" y_max="${slice_width / 2}"
                    h_min="${plate_underside_h}" h_max="${plate_top_h}" material="plate_clear_grey"/>
  </xacro:macro>

  <!-- ================= base_link: the axle midpoint (no visual, no inertia) ================= -->
  <!-- No <inertial> here on purpose: KDL (robot_state_publisher) does not support an inertia on the root link,
       so the body's mass lives in chassis_link, attached by a fixed joint.
       Isaac Sim (M2.T16): base_link and camera_optical_frame are the two links with NO <inertial> (no mass). How the
       Isaac URDF importer treats a massless link with merge_fixed_joints = False is NOT verified here. After the
       import, M2.T16 must check that neither became a rigid body with a default mass (the car's total must stay
       0.506 kg) and that the import log has no warnings about them. (In the Gazebo lab, sdformat's URDF converter
       merges fixed-joint links into their parent by default, so these frames get no body of their own there.) -->
  <link name="base_link"/>

  <!-- ================= chassis_link: the plate and everything rigidly on it ================= -->
  <!-- Boxes follow the real car (photos in assignments/assignment6/photos). None of them reaches the tyres:
       the tyres span |y| 53.5 to 80 mm and x -33.5 to +33.5 mm; the boxes stay inside |y| <= 51 mm where they
       overlap that x range, and the wide wing slices stay behind x = -42.14 mm. -->
  <link name="chassis_link">
    <!-- Clear acrylic plate, 3 mm thick (CAD), underside level at 44.5 mm floor (mean of the two B8 readings).
         Outline from the classmate's plate CAD (car_geometry_extras.xacro): rear apex -76.49, front apex +130.49 mm. -->
    <!-- 100 mm strip from the wing to where the front corners start to round: x -42.14 to +115.35 mm. -->
    <xacro:body_box name="plate_strip" x_min="${wing_front_x}" x_max="${front_round_x}"
                    y_min="${-plate_strip_width / 2}" y_max="${plate_strip_width / 2}"
                    h_min="${plate_underside_h}" h_max="${plate_top_h}" material="plate_clear_grey"/>
    <!-- Rounded front, x +115.35 to +130.49 mm: the R8 corner fillets and the R135.14 front arc, as front_slices stepped
         slices (3 slices: 99.2 / 89.2 / 52.0 mm). -->
    <xacro:plate_front_slice i="1"/>
    <xacro:plate_front_slice i="2"/>
    <xacro:plate_front_slice i="3"/>
    <!-- Rear wing, x -76.49 to -42.14 mm, as wing_slices stepped slices following the half-ellipse; the macro above
         computes each width from wing_depth and body_width (4 slices: 71.6 / 115.5 / 137.1 / 146.8 mm). -->
    <xacro:plate_wing_slice i="1"/>
    <xacro:plate_wing_slice i="2"/>
    <xacro:plate_wing_slice i="3"/>
    <xacro:plate_wing_slice i="4"/>

    <!-- TT motor gearboxes under the plate (bottom 30 mm floor measured; x and y ESTIMATE from IMG_7436). -->
    <xacro:body_box name="motor_left" x_min="${motor_x_min}" x_max="${motor_x_max}"
                    y_min="${motor_y_inner}" y_max="${motor_y_outer}"
                    h_min="${lowest_body_h}" h_max="${plate_underside_h}" material="motor_light_blue"/>
    <xacro:body_box name="motor_right" x_min="${motor_x_min}" x_max="${motor_x_max}"
                    y_min="${-motor_y_outer}" y_max="${-motor_y_inner}"
                    h_min="${lowest_body_h}" h_max="${plate_underside_h}" material="motor_light_blue"/>

    <!-- Breadboard on the plate over the rear wing (top 55 mm floor, x -70 to +20 mm, 100 mm wide: measured, B10/B12;
         centred on y = 0: ESTIMATE). -->
    <xacro:body_box name="breadboard" x_min="${breadboard_x_min}" x_max="${breadboard_x_max}"
                    y_min="${-breadboard_width / 2}" y_max="${breadboard_width / 2}"
                    h_min="${plate_top_h}" h_max="${breadboard_top_h}" material="breadboard_white"/>

    <!-- BNO055 board on the breadboard, 27 mm along x by 20 mm along y, centred on (imu_x, imu_y), so it moves with
         imu_link if either is re-measured. -->
    <xacro:body_box name="imu_board" x_min="${imu_x - imu_board_size_x / 2}" x_max="${imu_x + imu_board_size_x / 2}"
                    y_min="${imu_y - imu_board_size_y / 2}" y_max="${imu_y + imu_board_size_y / 2}"
                    h_min="${breadboard_top_h}" h_max="${imu_top_h}" material="imu_purple"/>

    <!-- 4 x AA battery holder on the plate (top 66 mm floor, x +40 to +100 mm, 63 mm wide: measured, B10/B13;
         centred on y = 0: ESTIMATE). -->
    <xacro:body_box name="battery_holder" x_min="${battery_x_min}" x_max="${battery_x_max}"
                    y_min="${-battery_width / 2}" y_max="${battery_width / 2}"
                    h_min="${plate_top_h}" h_max="${battery_top_h}" material="battery_black"/>

    <!-- ESP32-CAM + MB board stack at the front, from the battery holder's front face (+100 mm) to the measured
         front-most point (+138 mm), 20 mm wide, top 61 mm floor (B3/B13/B14); centred on y = 0: ESTIMATE. -->
    <xacro:body_box name="esp32_cam_stack" x_min="${esp32_x_min}" x_max="${axle_to_front}"
                    y_min="${-esp32_width / 2}" y_max="${esp32_width / 2}"
                    h_min="${plate_top_h}" h_max="${esp32_top_h}" material="esp32_black"/>

    <!-- LEGO Technic camera stand on the ESP32-CAM board, behind the camera module (top ~100 mm floor measured). -->
    <xacro:body_box name="camera_stand" x_min="${camera_x - camera_module_depth - stand_section}"
                    x_max="${camera_x - camera_module_depth}"
                    y_min="${camera_y - stand_section / 2}" y_max="${camera_y + stand_section / 2}"
                    h_min="${esp32_top_h}" h_max="${stand_top_h}" material="stand_grey"/>

    <!-- Inertia: box approximation. The chassis is treated as ONE uniform solid box of chassis_mass,
         207 x 100 x 36 mm (plate length x strip width x main-body height, motor bottoms to battery top),
         centred on the chassis centre of mass and aligned with base_link. Not measured; good enough for
         a slow indoor car (no pendulum / bifilar measurement was made). -->
    <inertial>
      <origin xyz="${chassis_com_x} ${chassis_com_y} ${chassis_com_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:solid_box_inertia m="${chassis_mass}" sx="${plate_front_x - plate_rear_x}"
                               sy="${plate_strip_width}" sz="${chassis_height}"/>
    </inertial>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= Drive wheels ================= -->
  <!-- Joint convention. M2.T4 step 5 writes the wheel joints as axis 0 1 0 with no joint rotation. This file keeps
       the convention of the instructor's Module 6 model instead: joint rpy (-pi/2, 0, 0) and axis 0 0 1.
       Both define the SAME spin axis: R_x(-pi/2) maps the child's z axis (0, 0, 1) onto base_link's +y (0, 1, 0),
       so the wheel spins about base_link +y either way, and a positive joint velocity drives the car toward +x.
       Why this one: a URDF cylinder is built along its own z axis, so with the joint frame already turned the tyre
       cylinder needs no extra visual rotation; and the instructor's lab model uses exactly this joint layout with the
       ignition DiffDrive plugin, so the Gazebo lab keeps its documented behaviour. robot_state_publisher and the
       Isaac URDF importer accept either form. -->
  <xacro:macro name="drive_wheel" params="side sign">
    <link name="${side}_wheel_link">
      <!-- What you see: the real tyre, a cylinder 67 mm across and 27 mm wide. -->
      <visual name="${side}_tyre_visual">
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <xacro:part_material name="tyre_black"/>
      </visual>
      <!-- What touches the floor: a SPHERE of the wheel radius. Reason given in the instructor's Module 6 guide
           (section 5.1): a sphere meets the ground at one point in the middle of the tyre, like a real tyre, while a
           cylinder meets it at its edges, which in the instructor's testing made the simulated robot turn about 20 %
           more than its wheel odometry computed. Side effect: the sphere bulges 20 mm past the tyre's outer face
           (|y| up to 100 mm) and into the body; self-collision is off by default in Gazebo and in the Isaac
           importer, so the inner overlap is harmless.
           Left UNNAMED on purpose: sdformat's URDF converter (checked with gz sdf 14.9 on 2026-10-10) drops the
           <gazebo reference> friction (mu1/mu2) of a link whose <collision> has a name attribute. -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:solid_cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${round(sign * wheel_separation / 2, 6)} 0" rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" sign="1"/>
  <xacro:drive_wheel side="right" sign="-1"/>

  <!-- ================= Caster ================= -->
  <!-- The swivel caster's white wheel, modelled as a sphere of radius caster_radius centred caster_radius above the
       floor at the TRAILING contact point (caster_x = 100 mm measured), so it touches the floor exactly:
       sphere bottom = caster_z - caster_radius = -wheel_radius. -->
  <link name="caster_link">
    <visual name="caster_wheel_visual">
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <xacro:part_material name="caster_white"/>
    </visual>
    <!-- Visual only (no collision, no mass): a block standing for the metal fork and top plate, from the wheel centre
         up to the plate underside and forward to just past the swivel axis (caster_swivel_x = 120 mm, measured C3).
         Its 22 mm width and the 2 mm / 8 mm margins are an ESTIMATE from IMG_7436. -->
    <visual name="caster_fork_visual">
      <origin xyz="${round((caster_swivel_x - caster_x + 0.010) / 2 - 0.002, 6)} 0 ${round((plate_underside_h - wheel_radius - caster_z) / 2, 6)}" rpy="0 0 0"/>
      <geometry><box size="${round(caster_swivel_x - caster_x + 0.010, 6)} 0.022 ${round(plate_underside_h - wheel_radius - caster_z, 6)}"/></geometry>
      <xacro:part_material name="caster_metal"/>
    </visual>
    <!-- Unnamed on purpose, like the tyres: a named collision loses the lab's mu = 0 caster friction in Gazebo.
         Isaac Sim (M2.T16): URDF carries no friction, and this file has no simulator blocks. The real caster SWIVELS,
         but here it is a fixed sphere, so it must slide freely: M2.T16 must bind a physics material with static and
         dynamic friction 0.0 to THIS collider (the plan's "caster 0.0"), and friction 1.0 to the two wheel colliders.
         With any non-zero friction the fixed sphere would drag sideways in turns, which a real swivel caster does not. -->
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <xacro:solid_sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} ${caster_y} ${caster_z}" rpy="0 0 0"/>
  </joint>

  <!-- ================= Camera ================= -->
  <!-- camera_link = the lens (optical centre), x forward, z up. camera_roll/pitch/yaw are 0: ASSUMED, not measured;
       the M1.T7 calibration (camera.json extrinsics) will set them. -->
  <link name="camera_link">
    <!-- The camera module, just behind the lens (visual only, size ESTIMATE). -->
    <visual name="camera_module_visual">
      <origin xyz="${-camera_module_depth / 2} 0 0" rpy="0 0 0"/>
      <geometry><box size="${camera_module_depth} ${camera_module_size} ${camera_module_size}"/></geometry>
      <xacro:part_material name="camera_dark"/>
    </visual>
    <inertial>
      <mass value="${camera_mass}"/>
      <xacro:solid_box_inertia m="${camera_mass}" sx="${camera_module_depth}" sy="${camera_module_size}" sz="${camera_module_size}"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="${camera_roll} ${camera_pitch} ${camera_yaw}"/>
  </joint>

  <!-- REP 103 optical frame: z forward (along the lens axis), x right, y down. Images are stamped with this frame. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>

  <!-- ================= IMU ================= -->
  <!-- imu_link = the BNO055 board centre at its top surface. rpy 0: ASSUMED (board flat and square to the car).
       The board's box is drawn in chassis_link (imu_board); this link carries only the frame and the stand-in mass. -->
  <link name="imu_link">
    <inertial>
      <mass value="${imu_mass}"/>
      <xacro:solid_box_inertia m="${imu_mass}" sx="${imu_board_size_x}" sy="${imu_board_size_y}"
                               sz="${imu_top_h - breadboard_top_h}"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

</robot>
