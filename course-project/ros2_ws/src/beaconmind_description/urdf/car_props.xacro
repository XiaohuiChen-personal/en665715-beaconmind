<?xml version="1.0"?>
<!--
  GENERATED by beaconmind_description/gen_props.py (M2.T4 step 4). Do not edit by hand: change
  configs/car.json (M1.T9, course-project/tools/write_car_json.py) or configs/camera.json (M1.T7) and run
  gen_props.py again. test_props_up_to_date fails while this file is out of date.

  AI-assisted: Claude Opus 5.5 (xhigh effort) via Claude Code, 2026-10-10: wrote the generator that writes
  this file. The measurements behind it are Xiaohui Chen's (2026-10-10).

  Inputs:
    course-project/configs/car.json  sha256 55488b314b99...
    camera.json: absent (M1.T7 calibration not done)
  Read through load_car_standin(), the stand-in for the M2.T3 view beaconmind.config.load_car.
  View status: measured. View assumptions (values from a stated default, not a measurement):
    - camera_rpy_deg: [0, 0, 0] (no calibrated extrinsics: configs/camera.json absent)
    - ticks_per_wheel_rev: 4320 (nominal, README 9.1; encoder counts not measured)

  Only the numbers car.json (and camera.json) carry are here. Plate outline, part boxes, part masses and the
  centre-of-mass inputs are in the hand-written car_geometry_extras.xacro (same folder).

  Conventions (M2.T4 / README C1): base_link = midpoint between the two drive-wheel centres, AT AXLE HEIGHT
  (z = 0 at the axle). +x = toward the camera lens / caster end (the car's front). +y = robot left. +z = up.
  Lengths in metres, masses in kg, angles in radians. Values named *_h are heights above the FLOOR (model
  z = floor height - wheel_radius); camera_h is one, imu_z (car.json imu_z_m) is already above the AXLE.
  Each comment gives the car.json entry: value, status, uncertainty and source row
  (assignments/assignment6/measurements.csv; evidence/M1/M1.T9/).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Drive wheels ================= -->
  <!-- car.json wheel_diameter_m = 0.067 m, measured +- 0.002 m (M1.T9 measurements.csv W1_tyre_diameter_direct (direct unloaded tyre diameter; NOT a roll-out)) -->
  <xacro:property name="wheel_diameter" value="0.067"/>
  <!-- derived: wheel_diameter / 2 -->
  <xacro:property name="wheel_radius" value="${round(wheel_diameter / 2, 6)}"/>
  <!-- car.json wheel_width_m = 0.027 m, measured +- 0.002 m (M1.T9 measurements.csv W2_tyre_width) -->
  <xacro:property name="wheel_width" value="0.027"/>
  <!-- car.json track_outer_m = 0.16 m, measured +- 0.002 m (M1.T9 measurements.csv W3_track_outer); outer tyre face to outer tyre face -->
  <xacro:property name="track_outer" value="0.16"/>
  <!-- car.json track_inner_m = 0.107 m, measured +- 0.002 m (M1.T9 measurements.csv W3_track_inner); inner face to inner face -->
  <xacro:property name="track_inner" value="0.107"/>
  <!-- view track_width_m, car.json track_width_m = 0.1335 m, measured +- 0.0014 m (M1.T9 (derived)) = (track_outer + track_inner) / 2, wheel centre to wheel centre -->
  <xacro:property name="track_width" value="0.1335"/>
  <!-- alias used by the Gazebo DiffDrive plugin and the instructor's lab file: identical to track_width -->
  <xacro:property name="wheel_separation" value="${track_width}"/>

  <!-- ================= Body extents ================= -->
  <!-- view axle_to_front_m, car.json front_overhang_m = 0.138 m, measured +- 0.003 m (M1.T9 measurements.csv B3_front_most_x); front-most point = ESP32-CAM USB-C side, no cable -->
  <xacro:property name="axle_to_front" value="0.138"/>
  <!-- view axle_to_rear_m, car.json rear_overhang_m = 0.07649 m, measured +- 0.003 m (M1.T9 measurements.csv B4_rear_most_x_corrected); rear-most point = plate rear edge -->
  <xacro:property name="axle_to_rear" value="0.07649"/>
  <!-- view body_width_m, car.json chassis_width_m = 0.14792 m, measured +- 0.0005 m (M1.T9 measurements.csv B5_plate_width_max_corrected); widest body point = the rear wing (tyres excluded) -->
  <xacro:property name="body_width" value="0.14792"/>
  <!-- view chassis_height_m, car.json chassis_height_m = 0.036 m, measured +- 0.0028 m (M1.T9 (derived)); main body height (gearbox bottoms to battery-holder top), used for the chassis inertia box -->
  <xacro:property name="chassis_height" value="0.036"/>

  <!-- ================= Camera (the lens = optical centre; camera_link sits here) ================= -->
  <!-- view camera_xyz_m[0], car.json lens_x_m = 0.12 m, measured +- 0.005 m (M1.T9 measurements.csv S3_lens_x); no camera.json, so the view uses the ruler reading -->
  <xacro:property name="camera_x" value="0.12"/>
  <!-- view camera_xyz_m[1], car.json lens_y_m = 0.0 m, measured +- 0.002 m (M1.T9 measurements.csv S3_lens_y); no camera.json, so the view uses the ruler reading -->
  <xacro:property name="camera_y" value="0.0"/>
  <!-- view lens_height_m, car.json lens_z_m = 0.075 m, measured +- 0.002 m (M1.T9 measurements.csv S3_lens_centre_h); lens height above the FLOOR -->
  <xacro:property name="camera_h" value="0.075"/>
  <!-- derived: camera_h - wheel_radius (base_link is at axle height) -->
  <xacro:property name="camera_z" value="${round(camera_h - wheel_radius, 6)}"/>
  <!-- ASSUMED by the view: camera_rpy_deg = [0, 0, 0] (no camera.json); the M1.T7 calibration sets it -->
  <xacro:property name="camera_roll" value="0.0"/>
  <!-- ASSUMED by the view: camera_rpy_deg = [0, 0, 0] (no camera.json); the M1.T7 calibration sets it -->
  <xacro:property name="camera_pitch" value="0.0"/>
  <!-- ASSUMED by the view: camera_rpy_deg = [0, 0, 0] (no camera.json); the M1.T7 calibration sets it -->
  <xacro:property name="camera_yaw" value="0.0"/>

  <!-- ================= IMU (the BNO055 board centre, at its top surface) ================= -->
  <!-- view imu_xyz_m[0], car.json imu_x_m = -0.061 m, measured +- 0.003 m (M1.T9 measurements.csv S1_imu_board_centre_x) -->
  <xacro:property name="imu_x" value="-0.061"/>
  <!-- view imu_xyz_m[1], car.json imu_y_m = 0.02 m, measured +- 0.002 m (M1.T9 measurements.csv S1_imu_board_centre_y_corrected); +y = robot LEFT -->
  <xacro:property name="imu_y" value="0.02"/>
  <!-- view imu_xyz_m[2], car.json imu_z_m = 0.0265 m, measured +- 0.0022 m (M1.T9 (derived): measurements.csv S1_imu_board_top_h (board top above the floor) - wheel_diameter_m / 2 = board top above the axle midpoint); board top above the AXLE (base_link) -->
  <xacro:property name="imu_z" value="0.0265"/>
  <!-- derived: imu_z + wheel_radius = board top above the FLOOR (for the board box) -->
  <xacro:property name="imu_top_h" value="${round(imu_z + wheel_radius, 6)}"/>

  <!-- ================= Caster (swivel: white wheel in a metal fork) ================= -->
  <!-- car.json caster_diameter_m = 0.025 m, measured +- 0.002 m (M1.T9 measurements.csv C1_caster_wheel_diameter_recheck) -->
  <xacro:property name="caster_diameter" value="0.025"/>
  <!-- derived: caster_diameter / 2. gen_props.py and beaconmind_car.urdf.xacro stop if it is not positive. -->
  <xacro:property name="caster_radius" value="${round(caster_diameter / 2, 6)}"/>
  <!-- view caster_xyz_m[0], car.json caster_x_m = 0.1 m, measured +- 0.005 m (M1.T9 measurements.csv C2_caster_contact_x); floor contact with the caster TRAILING -->
  <xacro:property name="caster_x" value="0.1"/>
  <!-- view caster_xyz_m[1] = 0.0 (the view puts the caster on the centre line; IMG_7436 shows it within about 4 mm) -->
  <xacro:property name="caster_y" value="0.0"/>
  <!-- derived: caster sphere centre = caster_radius - wheel_radius, so the sphere touches the floor (equals view caster_xyz_m[2]) -->
  <xacro:property name="caster_z" value="${round(caster_radius - wheel_radius, 6)}"/>

  <!-- ================= Mass ================= -->
  <!-- view mass_kg, car.json mass_kg = 0.506 kg, measured +- 0.0014 kg (M1.T9 measurements.csv K1_total_mass); batteries in, camera fitted, no cable -->
  <xacro:property name="mass" value="0.506"/>

</robot>
